# Facultatif : clé API Birdeye (gratuite), utilisée uniquement comme secours automatique si
# GeckoTerminal (source principale, sans clé) échoue. Créez un compte sur https://birdeye.so puis
# générez une clé dans l'onglet "Security" du tableau de bord. Sans elle, le bot fonctionne quand
# même, juste sans filet de sécurité en cas de panne GeckoTerminal.
BIRDEYE_API_KEY=

# Notifications Telegram (facultatif) — laissez ces lignes commentées pour désactiver.
# Créez un bot via @BotFather sur Telegram pour obtenir TELEGRAM_BOT_TOKEN, et envoyez-lui un
# message puis visitez https://api.telegram.org/bot<TOKEN>/getUpdates pour trouver TELEGRAM_CHAT_ID.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Réservé à la phase 2 (exécution réelle on-chain) — inutilisé en phase 1 (paper trading)
# SOLANA_WALLET_PRIVATE_KEY=
# RPC_URL=
