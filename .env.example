# Notifications Telegram (facultatif) — laissez ces lignes commentées pour désactiver.
# Créez un bot via @BotFather sur Telegram pour obtenir TELEGRAM_BOT_TOKEN, et envoyez-lui un
# message puis visitez https://api.telegram.org/bot<TOKEN>/getUpdates pour trouver TELEGRAM_CHAT_ID.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Réservé à la phase 2 (exécution réelle on-chain) — inutilisé en phase 1 (paper trading)
# SOLANA_WALLET_PRIVATE_KEY=
# RPC_URL=
